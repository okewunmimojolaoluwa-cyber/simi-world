# ══════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - Production Configuration
# ══════════════════════════════════════════════════════════════════
# 
# Copy this file to .env.local for development
# Set these values in your deployment platform (Vercel/Netlify) for production
# NEVER commit real passwords or keys to Git

# ── Supabase Database ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Authentication ────────────────────────────────────────────────
# Simi's password for accessing the gift dashboard
SIMI_ACCESS_PASSWORD=simi1234

# Admin password for secret dashboard access
ADMIN_ACCESS_PASSWORD=emmjay1234

# Session secret for signing cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=your-random-secret-key-here

# ── Deployment ────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-deployed-url.vercel.app

